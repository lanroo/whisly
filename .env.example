# ───────────────────────────────────────────────────────────────
# Whisly — variáveis de ambiente (copie para .env e preencha)
# ───────────────────────────────────────────────────────────────

# ── Frontend (apps/web) — precisam do prefixo VITE_ ──
# URL base da API consumida pelo app web
VITE_API_URL=http://localhost:3333
# Chave pública VAPID usada pelo navegador para assinar o push
VITE_VAPID_PUBLIC_KEY=

# ── Backend (apps/api) ──
# Porta do servidor Fastify
PORT=3333
# String de conexão do banco (SQLite no dev; troque por Postgres em prod)
DATABASE_URL="file:./dev.db"
# Segredos JWT (gere valores longos e aleatórios)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Origem permitida no CORS (o frontend)
CORS_ORIGIN=http://localhost:5173

# ── Web Push (VAPID) — gere com: npx web-push generate-vapid-keys ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@whisly.app
