{
  "name": "whisly",
  "version": "0.0.0",
  "private": true,
  "description": "Whisly — wishlist universal, mobile-first PWA com notificações push.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @whisly/web",
    "dev:web": "npm run dev --workspace @whisly/web",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @whisly/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,html}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
